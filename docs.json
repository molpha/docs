{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Molpha",
  "description": "Verifiable data infrastructure for smart contracts, backends, and AI agents. Any HTTP API → one threshold-signed payload → verified on Solana, EVM, and Starknet.",
  "logo": {
    "dark": "/logo/logo.svg",
    "light": "/logo/logo.svg",
    "href": "https://molpha.io"
  },
  "favicon": "/logo/favicon.svg",
  "colors": {
    "primary": "#9a641f",
    "light": "#cb852a",
    "dark": "#8f5c1c"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@molpha.io"
      },
      {
        "label": "github",
        "icon": "github",
        "href": "https://github.com/molpha"
      },
      {
        "label": "",
        "icon": "discord",
        "href": "https://discord.molpha.io"
      },
      {
        "label": "SDK",
        "href": "https://www.npmjs.com/package/@molpha/sdk"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "getting-started/introduction",
              "getting-started/how-it-works"
            ]
          },
          {
            "group": "Quickstarts",
            "pages": [
              "quickstarts/ai-agents",
              "quickstarts/smart-contracts",
              "quickstarts/backend",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "AI Agents",
            "pages": [
              "agents/overview",
              "mcp/molpha-mcp"
            ]
          },
          {
            "group": "Access Models",
            "pages": [
              "access-models/overview",
              "access-models/subscriptions",
              "access-models/delegates",
              "access-models/x402"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/feeds",
              "concepts/rounds-and-signatures",
              "concepts/registry-versions",
              "concepts/payloads"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/create-and-update",
              "guides/read-and-verify",
              "guides/verify-on-evm",
              "guides/verify-on-starknet"
            ]
          },
          {
            "group": "Gateways",
            "pages": [
              "gateways/overview",
              {
                "group": "Gateway API",
                "openapi": "gateway-openapi.yaml",
                "pages": [
                  "GET /health",
                  "GET /v1/nodes",
                  "POST /v1/round/execute",
                  "POST /v1/agent/execute",
                  "GET /v1/agent/{payer}/status"
                ]
              }
            ]
          },
          {
            "group": "Verifiers",
            "pages": [
              "verifiers/overview",
              "verifiers/solana",
              "verifiers/evm",
              "verifiers/starknet",
              "verifiers/deployments"
            ]
          },
          {
            "group": "Protocol",
            "pages": [
              "protocol/architecture",
              "protocol/cryptography",
              "protocol/security-model"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/payload-schema"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/glossary",
              "resources/faq",
              "resources/releases"
            ]
          }
        ]
      },
      {
        "tab": "SDK Reference",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/overview",
              "sdk/gateway-api",
              "sdk/reference"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/molpha_oracle",
      "discord": "https://discord.molpha.io",
      "github": "https://github.com/molpha",
      "linkedin": "https://www.linkedin.com/company/molpha-oracle"
    }
  },
  "api": {
    "openapi": "gateway-openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "params": {
      "expanded": "all"
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "go"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "contextual": {
    "options": ["copy", "download-spec", "chatgpt", "claude"]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Molpha Docs",
      "twitter:card": "summary_large_image",
      "twitter:site": "@molpha_oracle",
      "canonical": "https://docs.molpha.io"
    },
    "organization": {
      "id": "https://molpha.io/#organization",
      "name": "Molpha",
      "url": "https://molpha.io",
      "logo": "https://docs.molpha.io/logo/logo.svg",
      "sameAs": [
        "https://x.com/molpha_oracle",
        "https://discord.molpha.io",
        "https://github.com/molpha",
        "https://www.linkedin.com/company/molpha-oracle"
      ]
    }
  }
}
