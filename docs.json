{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Molpha",
  "description": "Any API. One threshold signature. Every chain. Threshold-signed data for smart contracts, backends and AI agents, verifiable on Solana, EVM and Starknet.",
  "logo": {
    "dark": "/logo/logo.svg",
    "light": "/logo/logo.svg",
    "href": "https://molpha.io"
  },
  "favicon": "/logo/favicon.svg",
  "colors": {
    "primary": "#9a641f",
    "light": "#cb852a",
    "dark": "#8f5c1c"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@molpha.io"
      },
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/molpha"
      },
      {
        "label": "Discord",
        "icon": "discord",
        "href": "https://discord.molpha.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "npm",
      "href": "https://www.npmjs.com/package/@molpha/sdk"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstarts/ai-agents",
              "quickstarts/backend",
              "quickstarts/smart-contracts"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/feeds",
              "concepts/attestations",
              "concepts/registry-versions"
            ]
          },
          {
            "group": "Access and payments",
            "pages": [
              "access-models/overview",
              "access-models/subscriptions",
              "access-models/delegates",
              "access-models/x402"
            ]
          },
          {
            "group": "MCP server",
            "pages": [
              "mcp/overview",
              "mcp/hosted",
              "mcp/local",
              "mcp/tools"
            ]
          },
          {
            "group": "Verify and publish",
            "pages": [
              "verifiers/overview",
              "verifiers/solana",
              "verifiers/evm",
              "verifiers/starknet",
              "guides/create-and-update",
              "verifiers/deployments"
            ]
          },
          {
            "group": "Protocol",
            "pages": [
              "protocol/architecture",
              "protocol/cryptography",
              "protocol/solana-program",
              "protocol/security-model"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/glossary",
              "resources/faq",
              "resources/releases"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Gateway API",
            "pages": [
              "gateways/overview"
            ]
          },
          {
            "group": "Rounds",
            "pages": [
              "gateways/api/round-execute",
              "gateways/api/x402-execute",
              "gateways/api/x402-status"
            ]
          },
          {
            "group": "Sign-in sessions",
            "pages": [
              "gateways/api/session-challenge",
              "gateways/api/session-create",
              "gateways/api/session-delete"
            ]
          },
          {
            "group": "Network",
            "pages": [
              "gateways/api/info",
              "gateways/api/nodes",
              "gateways/api/providers-list",
              "gateways/api/providers-get",
              "gateways/api/health"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/overview",
              "sdk/gateway-api",
              "sdk/reference"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/molpha_oracle",
      "discord": "https://discord.molpha.io",
      "github": "https://github.com/molpha",
      "linkedin": "https://www.linkedin.com/company/molpha-oracle"
    }
  },
  "api": {
    "openapi": "gateway-openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "params": {
      "expanded": "all"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "go"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "download-spec",
      "chatgpt",
      "claude"
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Molpha Docs",
      "twitter:card": "summary_large_image",
      "twitter:site": "@molpha_oracle",
      "canonical": "https://docs.molpha.io"
    },
    "organization": {
      "id": "https://molpha.io/#organization",
      "name": "Molpha",
      "url": "https://molpha.io",
      "logo": "https://docs.molpha.io/logo/logo.svg",
      "sameAs": [
        "https://x.com/molpha_oracle",
        "https://discord.molpha.io",
        "https://github.com/molpha",
        "https://www.linkedin.com/company/molpha-oracle"
      ]
    }
  },
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/"
    },
    {
      "source": "/getting-started/how-it-works",
      "destination": "/"
    },
    {
      "source": "/getting-started/quickstart",
      "destination": "/quickstarts/backend"
    },
    {
      "source": "/agents/overview",
      "destination": "/mcp/overview"
    },
    {
      "source": "/mcp/molpha-mcp",
      "destination": "/mcp/overview"
    },
    {
      "source": "/concepts/rounds-and-signatures",
      "destination": "/concepts/attestations"
    },
    {
      "source": "/concepts/payloads",
      "destination": "/concepts/attestations"
    },
    {
      "source": "/reference/payload-schema",
      "destination": "/concepts/attestations"
    },
    {
      "source": "/guides/read-and-verify",
      "destination": "/verifiers/solana"
    },
    {
      "source": "/guides/verify-on-evm",
      "destination": "/verifiers/evm"
    },
    {
      "source": "/guides/verify-on-starknet",
      "destination": "/verifiers/starknet"
    },
    {
      "source": "/gateways/api/agent-execute",
      "destination": "/gateways/api/x402-execute"
    },
    {
      "source": "/gateways/api/agent-status",
      "destination": "/gateways/api/x402-status"
    }
  ]
}
